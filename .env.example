# ── Firebase Client Config (get from Firebase Console → Project Settings) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://your-project.web.app

# ── Secrets (never commit real values) ──
SESSION_SECRET=generate-a-32+-char-random-string
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_API_KEY=your_google_api_key

# ── FormSubmit Email Notifications ──
# Activate at https://formsubmit.co — first submission triggers a verification email
FORMSUBMIT_ENDPOINT=https://formsubmit.co/ajax/info@studiofaraj.it

# ── Stripe (optional — enables paid features) ──
# Get the secret + webhook signing secret from your Stripe Dashboard.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Company Profile subscription prices. Create the product + recurring prices
# in the Stripe Dashboard, then paste the price ids here.
#   - Monthly: €4.99/month (30-day trial applied by code)
#   - Annual:  €49.99/year (2 months free vs monthly)
# The user can choose between them on the subscription/start page.
STRIPE_COMPANY_PROFILE_PRICE_ID=price_xxx
STRIPE_COMPANY_PROFILE_PRICE_ID_ANNUAL=price_yyy

# ── IndexNow (optional) ──
# Auto-notifies Bing/Yandex/Naver/Seznam when content is published from the
# admin dashboard. The default key is hardcoded in src/lib/indexnow.ts and
# served at /indexnow-key.txt (which IndexNow uses to verify ownership of the
# domain). Override here only if you want to rotate the key — and remember to
# update public/indexnow-key.txt to match.
# INDEXNOW_KEY=
# Set to anything truthy to skip IndexNow submissions entirely.
# INDEXNOW_DISABLED=
# Set to 1 to allow IndexNow submissions from non-production env (for
# end-to-end testing). Off by default — dev publishes would otherwise submit
# bogus URLs to Bing.
# INDEXNOW_FORCE=

# ── Analytics & search-engine verification ───────────────────────────────────
# All three are optional: the app renders no analytics and no verification tags
# unless the corresponding var is set, so leaving them blank is a safe default.
#
# GA4 measurement ID (looks like G-XXXXXXXXXX). The gtag script is only injected
# after the visitor grants the "analytics" cookie category — see
# src/components/analytics/google-analytics.tsx.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
#
# Search Console / Bing Webmaster ownership tokens. Paste ONLY the token value
# from the "HTML tag" verification method, not the whole <meta> element.
# Google:  <meta name="google-site-verification" content="THIS_PART_ONLY">
# Bing:    <meta name="msvalidate.01" content="THIS_PART_ONLY">
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
